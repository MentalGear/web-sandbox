{
  "name": "web-sandbox",
  "version": "1.0.0",
  "description": "Local-first sandbox for untrusted web content: opaque-origin iframe, immutable CSP, no backend.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/**/*.d.ts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:probes": "playwright test -c docs/research/15_strict_mode",
    "build:lib": "rm -rf dist && bun scripts/build-lib.ts && tsc -p tsconfig.build.json && bun scripts/declaration-specifiers.ts",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/bun": "^1.3.8",
    "es-module-lexer": "1.7.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.58.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
